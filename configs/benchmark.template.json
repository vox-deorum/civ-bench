{
  "name": "staff-standard-2026",
  "friendly_name": "Staff benchmark 2026, standard 8-seat map",
  "description": "TEMPLATE (tracked example: copy to a local, gitignored configs/benchmark*.json to run). Lean CORE run: which strategist is stronger (ratings) + how good is the win predictor (prediction + calibration), plus the strength panel that feeds ratings and a cost-efficiency axis. strategy-Elo is a group_by param, not a module. See benchmark.full.template.json for the opt-in extras. `catalogs` omitted; catalog-using stages resolve sibling defaults only when needed.",
  "seed": 42,
  "filters": {
    "staff_recent": {
      "experiments": [
        "2026-staff-standard"
      ],
      "min_games": 5,
      "min_condition_completeness": null,
      "max_decision_failure_pct": 0.2
    },
    "llm_only": {
      "only_llm": true,
      "min_games": 5
    },
    "late_game": {
      "turn_range": [
        200,
        null
      ]
    }
  },
  "groupings": {
    "strategy": {
      "kind": "argmax",
      "columns": [
        "domination_ratio",
        "culture_ratio",
        "diplomatic_ratio",
        "science_ratio"
      ],
      "labels": [
        "Domination",
        "Culture",
        "Diplomatic",
        "Science"
      ]
    }
  },
  "data": {
    "extract": {
      "enabled": true,
      "runs_dir": "runs/",
      "outputs": [
        "turns",
        "panel",
        "games",
        "tokens",
        "behavior"
      ],
      "max_dbs": null,
      "prune_missing": false,
      "force_rebuild": false,
      "issues_path": "runs/import_issues.csv"
    },
    "tables": {
      "turns": "runs/turn_data.csv",
      "panel": "runs/panel_data.csv",
      "games": "runs/game_data.csv",
      "tokens": "runs/model_token_usage.csv",
      "behavior": "runs/behavior_data.csv"
    },
    "filter": "staff_recent"
  },
  "estimators": [
    {
      "id": "score",
      "model": "score",
      "fit": "train",
      "predict": "in_sample",
      "enabled": true,
      "predict_subset": "all",
      "save_predictions": "reports/estimators/score/predictions.csv",
      "train": {
        "train_subset": "all",
        "resample": "none",
        "save_model": "reports/estimators/score/"
      }
    },
    {
      "id": "attention",
      "model": "attention_mlp",
      "fit": "train",
      "predict": "in_sample",
      "enabled": true,
      "features": {
        "include": null,
        "exclude": [
          "civ_*"
        ]
      },
      "predict_subset": "all",
      "save_predictions": "reports/estimators/attention/predictions.csv",
      "tune": {
        "enabled": true,
        "engine": "optuna",
        "search": "hyperparameters",
        "n_trials": 200,
        "objective": "brier_score",
        "n_splits": 5,
        "resample": "none",
        "n_jobs": 1,
        "storage": "reports/estimators/attention/tuning.db",
        "save_params": "reports/estimators/attention/best_params.json",
        "load_params": null
      },
      "train": {
        "train_subset": "all",
        "resample": "none",
        "save_model": "reports/estimators/attention/"
      }
    },
    {
      "id": "xgboost_cv",
      "model": "xgboost",
      "fit": "train",
      "predict": "cross_val",
      "enabled": true,
      "save_predictions": "reports/estimators/xgboost_cv/oof_predictions.csv",
      "train": {
        "train_subset": "all",
        "resample": "none",
        "n_splits": 5,
        "save_importance": true
      }
    }
  ],
  "adjust": [
    {
      "id": "strength",
      "module": "strength",
      "enabled": true,
      "uses": {
        "estimators": [
          "attention"
        ]
      },
      "save": "reports/adjust/player_strength_panel.csv",
      "params": {
        "turn_progress_min": 0.2,
        "weight": "turn_progress",
        "relative_to": "game_leader",
        "enforce_winner": true,
        "civ_adjust": "ols_logit",
        "block": "auto",
        "post_cell_normalize": "none",
        "cell_gain_bend": 0.5
      }
    }
  ],
  "analyses": [
    {
      "id": "bt_main",
      "module": "ratings.bradley_terry",
      "enabled": true,
      "uses": {
        "tables": [
          "strength"
        ]
      },
      "params": {
        "group_by": [
          "player_type"
        ],
        "weighted": true,
        "ref": "Vanilla",
        "min_games": 5,
        "bootstrap": null
      }
    },
    {
      "id": "bt_strategy",
      "module": "ratings.bradley_terry",
      "enabled": true,
      "uses": {
        "tables": [
          "strength"
        ]
      },
      "params": {
        "group_by": [
          "player_type",
          "strategy"
        ],
        "weighted": true,
        "ref": "Vanilla",
        "min_games": 5,
        "bootstrap": null
      }
    },
    {
      "id": "matchup_strength",
      "module": "ratings.matchups",
      "enabled": true,
      "uses": {
        "tables": [
          "strength"
        ]
      },
      "params": {
        "mode": "both",
        "validate_ols": true
      }
    },
    {
      "id": "matchup_winrates",
      "module": "ratings.outcome_matchups",
      "enabled": true,
      "uses": {
        "tables": [
          "panel"
        ]
      },
      "params": {
        "include_score_ratio": true
      }
    },
    {
      "id": "pred_metrics",
      "module": "prediction.evaluate",
      "enabled": true,
      "params": {
        "metrics": [
          "roc_auc",
          "brier_score",
          "log_loss",
          "balanced_accuracy"
        ]
      }
    },
    {
      "id": "pred_compare",
      "module": "prediction.compare",
      "enabled": true,
      "params": {}
    },
    {
      "id": "cal_reliability",
      "module": "calibration.reliability",
      "enabled": true,
      "params": {
        "n_bins": 10
      }
    },
    {
      "id": "cal_loss_progress",
      "module": "calibration.loss_by_progress",
      "enabled": true,
      "params": {
        "n_bins": 20,
        "metrics": [
          "brier_score",
          "log_loss"
        ]
      }
    },
    {
      "id": "cal_civ_effects",
      "module": "calibration.civ_effects",
      "enabled": true,
      "uses": {
        "tables": [
          "strength"
        ]
      },
      "params": {}
    },
    {
      "id": "cal_cell_baseline",
      "module": "calibration.cell_baseline",
      "enabled": true,
      "uses": {
        "tables": [
          "strength"
        ]
      },
      "params": {}
    },
    {
      "id": "perf_score_ratio",
      "module": "performance.score_ratio",
      "enabled": true,
      "params": {
        "target": "score_ratio",
        "predictors": [
          "player_type",
          "civilization"
        ]
      }
    },
    {
      "id": "perf_strength",
      "module": "performance.strength_panel",
      "enabled": true,
      "uses": {
        "tables": [
          "strength"
        ]
      },
      "params": {
        "metric": "adjusted_strength",
        "by": "player_type"
      }
    },
    {
      "id": "perf_experiment_completeness",
      "module": "performance.experiment_completeness",
      "enabled": true,
      "uses": {
        "tables": [
          "strength",
          "tokens"
        ]
      },
      "params": {}
    },
    {
      "id": "perf_turn_predicted",
      "module": "performance.turn_predicted",
      "enabled": true,
      "uses": {
        "tables": [
          "strength"
        ]
      },
      "params": {
        "aggregate": "mean",
        "by": "player_type"
      }
    },
    {
      "id": "game_log",
      "module": "performance.game_log",
      "enabled": true,
      "uses": {},
      "params": {}
    },
    {
      "id": "perf_usage_efficiency",
      "module": "performance.usage_efficiency",
      "enabled": true,
      "uses": {
        "tables": [
          "tokens"
        ],
        "analyses": [
          "bt_main"
        ]
      },
      "params": {
        "currency": "usd",
        "log_x": true,
        "annotate": false
      }
    }
  ],
  "report": {
    "out_dir": "reports/",
    "formats": [
      "md",
      "html"
    ],
    "sections": null,
    "overview_sections": [
      "bt_main",
      "matchup_winrates",
      "pred_metrics",
      "perf_strength",
      "perf_usage_efficiency",
      "beh_flavors",
      "beh_diplomacy",
      "beh_commitment"
    ],
    "section_overrides": {},
    "title": null,
    "footer": null,
    "intro": {
      "eyebrow": "CivBench · Civilization V with Vox Populi 5.2.7",
      "headline": "Which AI makes the best long-term strategist?",
      "body": "Civilization V is a strategy game where you lead a nation from its first village to the space age. A single game takes hundreds of turns, and the winner is often decided by choices made long before the end. That makes it a good test of whether an AI can plan ahead.\n\nIn each game, one AI model guides two of the eight nations. It sets their long-term plans: what to focus on, who to befriend, and when to go to war. The built-in AI runs the other six. Every model plays the same three maps from every starting spot, so nobody wins on luck. A game has only one winner, so we also follow each player's chance of winning at every turn, and turn all of that into a rating.",
      "glossary": {
        "built-in AI": "The computer players that come with Vox Populi. They are among the strongest AI opponents made for Civilization V.",
        "chance of winning": "At every turn, a model trained on hundreds of past games estimates each player's chance of winning from the state of the game: cities, science, army, and more.",
        "rating": "A chess-style score. 1500 means exactly as strong as the built-in AI. Each 100 points above that means winning head-to-head about 64% of the time instead of 50%."
      },
      "names": {
        "Vanilla": "Built-in AI",
        "Null": "Do-nothing player"
      },
      "conditions": {
        "Every-turn": {
          "label": "every turn",
          "tip": "The AI is asked for a new plan on every turn."
        },
        "Per-5": {
          "label": "every 5 turns",
          "tip": "The AI is asked for a new plan every 5 turns, or sooner when something big happens, like a declaration of war. This costs much less than asking every turn."
        }
      },
      "series": [
        {
          "name": "Claude",
          "models": [
            "Opus-*",
            "Sonnet-*",
            "Haiku-*"
          ]
        },
        {
          "name": "GPT",
          "models": [
            "GPT-*"
          ]
        },
        {
          "name": "Gemma",
          "models": [
            "Gemma-*",
            "Gemini-*"
          ]
        },
        {
          "name": "Qwen",
          "models": [
            "Qwen-*"
          ]
        },
        {
          "name": "GLM",
          "models": [
            "GLM-*"
          ]
        },
        {
          "name": "Kimi",
          "models": [
            "Kimi-*"
          ]
        },
        {
          "name": "DeepSeek",
          "models": [
            "DeepSeek-*"
          ]
        },
        {
          "name": "MiniMax",
          "models": [
            "MiniMax-*"
          ]
        },
        {
          "name": "Nemotron",
          "models": [
            "Nemotron-*"
          ]
        }
      ],
      "facts": [
        {
          "value": "models",
          "label": "AI models",
          "tip": "Language models from {makers} makers, from large commercial ones to small open ones you can run at home."
        },
        {
          "value": "setups",
          "label": "setups tested",
          "tip": "Most models are tested two ways: deciding every turn, and deciding every 5 turns."
        },
        {
          "value": "games",
          "label": "games played",
          "tip": "Each game has 8 nations. Every setup plays at least {min_games} games."
        },
        {
          "value": "turns",
          "label": "turns per game",
          "tip": "The typical game length. Half of all games run longer than this."
        },
        {
          "value": "starts",
          "label": "fixed starts",
          "tip": "Every AI plays the same {starts} maps and rotates through every starting spot, so no one gets a lucky map or a lucky start."
        }
      ],
      "projects": {
        "title": "What is this built on?",
        "text": "Three pieces of software make these games possible. You do not need to play any of them to read this report.",
        "items": [
          {
            "name": "Civilization V",
            "url": "https://store.steampowered.com/app/8930/",
            "link": "Steam store page",
            "text": "A 2010 strategy game by Firaxis. You lead a nation through history one turn at a time: building cities, trading, making friends and enemies."
          },
          {
            "name": "Vox Populi",
            "url": "https://github.com/LoneGazebo/Community-Patch-DLL",
            "link": "Vox Populi on GitHub",
            "text": "A large community mod that rebalances Civilization V and makes its computer players much smarter. All games here use version 5.2.7."
          },
          {
            "name": "Vox Deorum",
            "url": "https://github.com/vox-deorum",
            "link": "Vox Deorum on GitHub",
            "text": "Our open-source bridge that lets a language model read the game and steer a nation. The built-in AI still moves the units; the language model sets the strategy."
          }
        ],
        "links": [
          {
            "label": "Watch any game in the replay viewer",
            "url": "https://vox-deorum.github.io/vox-deorum-replay/"
          },
          {
            "label": "Read the CivBench paper",
            "url": "https://arxiv.org/abs/2604.07733"
          },
          {
            "label": "Read the Vox Deorum paper",
            "url": "https://arxiv.org/abs/2512.18564"
          }
        ]
      },
      "charts": {
        "leaderboard": {
          "stage": "bt_main",
          "title": "Who plays best?",
          "text": "Each bar shows how far an AI setup's rating sits above or below the built-in AI, the dashed line. Hover a row for details."
        },
        "cost": {
          "stage": "perf_usage_efficiency",
          "title": "Is the pricier model worth it?",
          "text": "Paying more usually buys a bit more skill. Setups above the dashed line play better than their price suggests. Hover a series or a point to pick out its models, or click a series to keep it picked."
        }
      }
    },
    "include_disabled": false,
    "replay": null,
    "publish": {
      "enabled": false
    }
  }
}