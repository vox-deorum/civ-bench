{
  "name": "staff-standard-2026-full",
  "description": "Kitchen-sink run: the lean CORE (see benchmark.json) plus every OPTIONAL module wired but `\"enabled\": false`, so opting in is a one-flag edit. Also demonstrates the folded params (bootstrap CIs on bt_main; strategy grouping on bt_strategy) and a pre-trained estimator. behavior.* is deferred and intentionally absent.",
  "seed": 42,

  "filters": {
    "staff_recent": { "experiments": ["2026-staff-standard"], "min_games": 5 },
    "llm_only": { "only_llm": true, "min_games": 5 },
    "late_game": { "turn_range": [200, null] }
  },

  "groupings": {
    "strategy": {
      "kind": "argmax",
      "columns": ["domination_ratio", "culture_ratio", "diplomatic_ratio", "science_ratio"],
      "labels": ["Domination", "Culture", "Diplomatic", "Science"]
    }
  },

  "data": {
    "extract": {
      "enabled": true,
      "runs_dir": "runs/",
      "outputs": ["turns", "panel", "timestamps", "tokens"],
      "max_dbs": null,
      "prune_missing": false,
      "force_rebuild": false
    },
    "tables": {
      "turns": "runs/turn_data.csv",
      "panel": "runs/panel_data.csv",
      "timestamps": "runs/game_timestamps.csv",
      "tokens": "runs/model_token_usage.csv"
    },
    "filter": "staff_recent"
  },

  "estimators": [
    {
      "id": "score",
      "model": "score",
      "fit": "train",
      "predict": "in_sample",
      "enabled": true,
      "predict_subset": "all",
      "save_predictions": "reports/estimators/score/predictions.csv",
      "train": {
        "train_subset": "all",
        "resample": "none",
        "save_model": "reports/estimators/score/"
      }
    },
    {
      "id": "attention",
      "model": "attention_mlp",
      "fit": "train",
      "predict": "in_sample",
      "enabled": true,
      "features": {
        "include": null,
        "exclude": ["civ_*"]
      },
      "predict_subset": "all",
      "save_predictions": "reports/estimators/attention/predictions.csv",
      "tune": {
        "enabled": true,
        "engine": "optuna",
        "search": "hyperparameters",
        "n_trials": 200,
        "objective": "brier_score",
        "n_splits": 5,
        "resample": "none",
        "n_jobs": 1,
        "storage": "reports/estimators/attention/tuning.db",
        "save_params": "reports/estimators/attention/best_params.json",
        "load_params": null
      },
      "train": {
        "train_subset": "all",
        "resample": "none",
        "save_model": "reports/estimators/attention/"
      }
    },
    {
      "id": "attention_ref",
      "model": "attention_mlp",
      "fit": "pretrained",
      "enabled": true,
      "predict_subset": "all",
      "save_predictions": "reports/estimators/attention_ref/predictions.csv",
      "pretrained": {
        "model_dir": "reports/reference/attention_2026q1/"
      }
    },
    {
      "id": "xgboost_cv",
      "model": "xgboost",
      "fit": "train",
      "predict": "cross_val",
      "enabled": true,
      "save_predictions": "reports/estimators/xgboost_cv/oof_predictions.csv",
      "train": {
        "train_subset": "all",
        "resample": "none",
        "n_splits": 5,
        "save_importance": true
      }
    }
  ],

  "adjust": [
    {
      "id": "strength",
      "module": "strength",
      "enabled": true,
      "uses": { "estimators": ["attention"] },
      "save": "reports/adjust/player_strength_panel.csv",
      "params": {
        "turn_progress_min": 0.2,
        "weight": "turn_progress",
        "relative_to": "game_leader",
        "enforce_winner": true,
        "civ_adjust": "ols_logit"
      }
    }
  ],

  "analyses": [
    {
      "id": "bt_main",
      "module": "ratings.bradley_terry",
      "enabled": true,
      "uses": { "tables": ["strength"] },
      "params": { "group_by": ["player_type"], "weighted": true, "ref": "Vanilla", "min_games": 5, "only_llm": false, "bootstrap": { "n": 1000, "stratified": true } }
    },
    {
      "id": "bt_strategy",
      "module": "ratings.bradley_terry",
      "enabled": true,
      "uses": { "tables": ["strength"] },
      "params": { "group_by": ["player_type", "strategy"], "weighted": true, "ref": "Vanilla", "min_games": 5, "bootstrap": null }
    },
    {
      "id": "pl_main",
      "module": "ratings.plackett_luce",
      "enabled": true,
      "uses": { "tables": ["strength"] },
      "params": { "group_by": ["player_type"], "ref": "Vanilla", "min_games": 5, "bootstrap": null }
    },
    {
      "id": "matchups",
      "module": "ratings.matchups",
      "enabled": true,
      "uses": { "tables": ["strength"] },
      "params": { "mode": "mean", "validate_ols": true }
    },
    {
      "id": "ratings_ablation_bt",
      "module": "ratings.ablation_bt",
      "enabled": false,
      "uses": { "tables": ["strength"] },
      "params": { "weighted": true }
    },
    {
      "id": "ratings_vanilla_slot_effect",
      "module": "ratings.vanilla_slot_effect",
      "enabled": false,
      "uses": { "tables": ["strength"] },
      "params": {}
    },
    {
      "id": "pred_metrics",
      "module": "prediction.evaluate",
      "enabled": true,
      "uses": { "estimators": ["score", "attention", "attention_ref", "xgboost_cv"] },
      "params": { "metrics": ["roc_auc", "brier_score", "log_loss", "balanced_accuracy"] }
    },
    {
      "id": "pred_compare",
      "module": "prediction.compare",
      "enabled": true,
      "uses": { "estimators": ["score", "attention", "attention_ref", "xgboost_cv"] },
      "params": {}
    },
    {
      "id": "pred_winner_trajectories",
      "module": "prediction.winner_trajectories",
      "enabled": false,
      "uses": { "estimators": ["attention"] },
      "params": { "sample_games": 12 }
    },
    {
      "id": "pred_vs_elo",
      "module": "prediction.elo_comparison",
      "enabled": false,
      "uses": { "estimators": ["attention"] },
      "needs": ["bt_main"],
      "params": {}
    },
    {
      "id": "pred_context_slicing",
      "module": "prediction.context_slicing",
      "enabled": false,
      "uses": { "estimators": ["attention"] },
      "params": { "by": ["experiment", "player_type"] }
    },
    {
      "id": "cal_reliability",
      "module": "calibration.reliability",
      "enabled": true,
      "uses": { "estimators": ["xgboost_cv"] },
      "params": { "n_bins": 10 }
    },
    {
      "id": "cal_loss_progress",
      "module": "calibration.loss_by_progress",
      "enabled": true,
      "uses": { "estimators": ["score", "xgboost_cv"] },
      "filter": "late_game",
      "params": { "n_bins": 20, "metrics": ["brier_score", "log_loss"] }
    },
    {
      "id": "perf_score_ratio",
      "module": "performance.score_ratio",
      "enabled": true,
      "params": { "target": "score_ratio", "predictors": ["player_type", "civilization"] }
    },
    {
      "id": "perf_strength",
      "module": "performance.strength_panel",
      "enabled": true,
      "uses": { "tables": ["strength"] },
      "params": { "metric": "adjusted_strength", "by": "player_type" }
    },
    {
      "id": "perf_turn_predicted",
      "module": "performance.turn_predicted",
      "enabled": true,
      "uses": { "estimators": ["attention"] },
      "params": { "aggregate": "mean", "by": "player_type" }
    },
    {
      "id": "perf_perm_importance",
      "module": "performance.permutation_importance",
      "enabled": false,
      "uses": { "estimators": ["xgboost_cv"] },
      "params": { "n_repeats": 20, "groups": "feature_families" }
    },
    {
      "id": "explore_panel",
      "module": "exploratory.panel",
      "enabled": false,
      "params": {}
    },
    {
      "id": "explore_turn",
      "module": "exploratory.turn",
      "enabled": false,
      "params": {}
    },
    {
      "id": "explore_strategy_profiles",
      "module": "exploratory.strategy_profiles",
      "enabled": false,
      "uses": { "tables": ["strength"] },
      "params": { "by": "player_type" }
    },
    {
      "id": "explore_token_costs",
      "module": "exploratory.model_token_costs",
      "enabled": true,
      "uses": { "tables": ["tokens"] },
      "params": { "currency": "usd" }
    }
  ],

  "report": {
    "template": "default",
    "out_dir": "reports/",
    "formats": ["md", "html"],
    "sections": null,
    "title": null,
    "include_disabled": false
  }
}
